Algoritmo "Animal"

tipo
    animal = registro
    raca : caractere
    peso : real
    idade : inteiro
    doente : caractere
fimregistro

Var
// Seção de Declarações das variáveis 

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc...
escreva("Raça: ")
leia()

escreva("Peso: ")
leia()

escreva("Idade: ")
leia()
    
escreva("Está doente? (s/n): ")
leia()

escreval()
escreval("Raça: ", )
escreval("Peso: ", )
escreval("Idade: ", )
escreval("Doente? ", )
Fimalgoritmo